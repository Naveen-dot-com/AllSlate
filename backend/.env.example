# Copy this file to `backend/.env` and fill in real values.
# NEVER commit the real `.env` file — it is already covered by .gitignore.
# In production (Render/Fly/Railway/Azure/etc.), set these as the host's
# environment variables/secrets instead of shipping a .env file.

# --- CORS -------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Include your local Next.js dev server and your deployed Vercel domain.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://your-app.vercel.app

# --- Vercel / deployment -------------------------------------------------
# Keep these aligned with the frontend project variables in Vercel.
# Use your deployed backend origin here when running the API separately from
# the frontend; the frontend will also set ALLSLATE_API_URL or NEXT_PUBLIC_ALLSLATE_API_URL.
ALLSLATE_API_URL=https://your-backend-url.example.com

# --- LLM (Gemini) -------------------------------------------------------
# Google AI Studio / Vertex AI key used by backend/app/rag/generation.py.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias accepted by the backend for Vercel deployments.
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Database / Supabase -----------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# Public client-safe key. The frontend should also receive NEXT_PUBLIC_SUPABASE_URL
# and NEXT_PUBLIC_SUPABASE_ANON_KEY with the same values.
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side secret; keep this only in the backend environment.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Direct Postgres connection string (Project Settings -> Database), used if/when
# the backend talks to Postgres/pgvector directly instead of via the Supabase SDK.
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Optional Vercel-compatible aliases used by the backend when the frontend and
# backend share the same project environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Google OAuth (for Supabase Auth "Sign in with Google") -------------
# Created in Google Cloud Console -> APIs & Services -> Credentials, then
# registered under Supabase Dashboard -> Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Web search (optional RAG feature) ----------------------------------
# Only needed if/when web-search augmentation is wired to a real provider.
WEB_SEARCH_API_KEY=your_web_search_key_here
EXA_API_KEY=your_web_search_key_here

# --- Document processing hardening thresholds (see backend/app/config.py) --
# Safe to leave at defaults; override per-environment if needed.
OCR_CONFIDENCE_PARTIAL_THRESHOLD=0.75
OCR_CONFIDENCE_UNCERTAIN_THRESHOLD=0.55
TABLE_REGULARITY_PARTIAL_THRESHOLD=0.8
TABLE_REGULARITY_UNCERTAIN_THRESHOLD=0.6
PARTIAL_VS_FAIL_THRESHOLD=0.25
SUPPORTED_LANGUAGES=en,es,fr
