# Copy this file to `frontend/.env.local` for local development.
# In Vercel: Project Settings -> Environment Variables (do NOT commit real values).

# URL of the deployed/local FastAPI backend. Used at build/runtime by
# next.config.mjs to proxy `/api/*` requests (see rewrites()).
# For Vercel production, set this to the backend origin, e.g.
# https://allslate-api.vercel.app or your Railway/Render/Fly host.
ALLSLATE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALLSLATE_API_URL=http://127.0.0.1:8000

# --- Supabase (client-side auth) ----------------------------------------
# Public by design (NEXT_PUBLIC_ prefix) — protected by Supabase Row Level
# Security, not secrecy. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: if the frontend and backend share the same Vercel environment, keep
# the same values available there as well.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
